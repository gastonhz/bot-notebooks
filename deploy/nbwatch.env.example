# /etc/nbwatch.env: secretos y rutas. Lo leen los units de systemd y el atajo /usr/local/bin/nbwatch.

# Bot de Telegram (BotFather -> /newbot). El chat_id se obtiene con: nbwatch telegram-chat-id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Opcional, con instant_alerts.priority: high: las alertas inmediatas van por un canal aparte, al que
# Telegram le puede poner otro sonido. Un segundo bot (su token; el chat_id es el mismo) u otro chat.
# Vacíos = van al chat de siempre.
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Token de tu suscripción de Claude para el modo headless. Generalo con `claude setup-token`
# (en cualquier máquina donde puedas abrir el navegador) y pegalo acá.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_BIN=/var/lib/nbwatch/.local/bin/claude

NBWATCH_STATE_DIR=/var/lib/nbwatch
NBWATCH_CRITERIA=/var/lib/nbwatch/criteria.yaml
PLAYWRIGHT_BROWSERS_PATH=/opt/nbwatch/ms-playwright

# Interfaz web (systemctl enable --now nbwatch-web, puerto 8080). Sin usuario y clave no arranca.
NBWATCH_WEB_USER=
NBWATCH_WEB_PASSWORD=
