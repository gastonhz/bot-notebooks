[Unit]
Description=nbwatch: scrape de ofertas de notebooks
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=nbwatch
Group=nbwatch
EnvironmentFile=/etc/nbwatch.env
WorkingDirectory=/opt/nbwatch
ExecStart=/opt/nbwatch/venv/bin/python -m nbwatch scrape
TimeoutStartSec=45min
Nice=10
