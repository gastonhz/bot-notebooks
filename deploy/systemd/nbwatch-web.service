[Unit]
Description=nbwatch: interfaz web (criterios, prompt del juez, correr a mano)
After=network-online.target
Wants=network-online.target

[Service]
User=nbwatch
Group=nbwatch
EnvironmentFile=/etc/nbwatch.env
WorkingDirectory=/opt/nbwatch
ExecStart=/opt/nbwatch/venv/bin/python -m nbwatch web --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=10
Nice=10

[Install]
WantedBy=multi-user.target
